{
  "name": "is-kebab-case",
  "version": "1.0.3",
  "description": "Check if a string is kebab-case",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "dev": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "kebab-case",
    "kebab",
    "case",
    "string",
    "check",
    "validate",
    "is"
  ],
  "author": "Piyush Jha",
  "homepage": "https://github.com/Hackinet/is-kebab-case#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hackinet/is-kebab-case.git"
  },
  "bugs": {
    "url": "https://github.com/Hackinet/is-kebab-case/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
